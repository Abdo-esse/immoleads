# ═══════════════════════════════════════
# ImmoLeads — Environment Variables
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cron Security ──
# Used by /api/cron/follow-ups to verify cron triggers
CRON_SECRET=your-random-secret-here

# ── Leads Webhook Security ──
# Secret required to authenticate incoming webhook leads (/api/webhooks/leads)
LEADS_WEBHOOK_SECRET=your-random-webhook-secret-here

# ── WhatsApp Business API (Optional) ──
# Configure in Settings > Integrations if you want direct messaging
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-access-token
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
